<resources>
    <!-- Zeigt SpO2 (Entwickler-Feld id 0) und VO2max (id 3) in Garmin Connect.
         Atmung und Stress zeichnet die Uhr beim Typ Yoga selbst auf.
         Falls der Compiler diese Datei beanstandet: Datei loeschen, die Werte
         stehen trotzdem in der FIT-Datei. -->
    <fitContributions>
        <fitField
            id="0"
            displayInChart="true"
            sortOrder="0"
            precision="0"
            chartTitle="@Strings.SpO2Title"
            dataLabel="@Strings.SpO2Label"
            unitLabel="@Strings.PercentUnit"
            fillColor="#0099FF" />
        <fitField
            id="3"
            displayInChart="true"
            sortOrder="1"
            precision="0"
            chartTitle="@Strings.Vo2Title"
            dataLabel="@Strings.Vo2Label"
            unitLabel="@Strings.NoUnit"
            fillColor="#CC66FF" />
    </fitContributions>
</resources>
